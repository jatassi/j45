          {
            "name": "A: Sandbag/dumbbell clean + forward lunge · B: Sandbag/dumbbell bear-hug squat (pause)"
          },
          {
            "name": "A: Barbell hang clean · B: Slam ball / dumbbell over-shoulder throw"
          },
          {
            "name": "A: Dumbbell speed sumo squat + curl · B: Push-up + spider lunge + row"
