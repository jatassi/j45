{
  "name": "@j45/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "PORT=${SERVER_PORT:-3000} SERVE_CLIENT=false APP_EXTRA_ORIGINS=http://$(ipconfig getifaddr en0 2>/dev/null):5173 bun --watch src/main.ts",
    "start": "bun run src/main.ts"
  },
  "dependencies": {
    "@effect/experimental": "0.60.0",
    "@effect/platform": "0.96.2",
    "@effect/platform-bun": "0.90.0",
    "@effect/rpc": "0.75.1",
    "@effect/sql": "0.51.1",
    "@effect/sql-sqlite-bun": "0.52.0",
    "@j45/domain": "workspace:*",
    "@simplewebauthn/server": "13.3.2",
    "effect": "3.21.4"
  },
  "devDependencies": {
    "@effect/cluster": "0.59.0",
    "@effect/platform-node": "0.107.0",
    "@effect/sql-sqlite-node": "0.52.0",
    "@effect/workflow": "0.18.2"
  }
}
