{
  "name": "j45",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run --filter '*' check",
    "test": "bunx vitest run",
    "test:e2e": "playwright test",
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '@j45/client' build",
    "deploy:sim": "bash scripts/deploy-sim.sh",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write \"packages/*/{src,test,migrations}/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/{src,test,migrations}/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\"",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@effect/vitest": "0.29.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^7.0.2",
    "vitest": "3.2.7"
  }
}
